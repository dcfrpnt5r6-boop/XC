local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

local isFlying = false
local flightSpeed = 1
local moveUp = false
local moveDown = false
local attachment, linearVelocity, bodyGyro

local function startFlight()
	isFlying = true
	FlyButton.Text = "Fly: ON"
	FlyButton.BackgroundColor3 = Color3.fromRGB(114, 137, 218)

	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid then return end

	humanoid.PlatformStand = true

	attachment = Instance.new("Attachment")
	attachment.Name = "FlightAttachment"
	attachment.Parent = hrp

	linearVelocity = Instance.new("LinearVelocity")
	linearVelocity.Attachment0 = attachment
	linearVelocity.MaxForce = math.huge
	linearVelocity.VectorVelocity = Vector3.new(0, 0, 0)
	linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	linearVelocity.Parent = hrp

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	bodyGyro.P = 25000
	bodyGyro.Parent = hrp
end

local function stopFlight()
	isFlying = false
	FlyButton.Text = "Fly: OFF"
	FlyButton.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
	moveUp = false
	moveDown = false

	if linearVelocity then linearVelocity:Destroy() end
	if bodyGyro then bodyGyro:Destroy() end
	if attachment then attachment:Destroy() end

	local char = player.Character
	if char then
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid then humanoid.PlatformStand = false end
	end
end

FlyButton.MouseButton1Click:Connect(function()
	if isFlying then stopFlight() else startFlight() end
end)

UpButton.MouseButton1Down:Connect(function() moveUp = true end)
UpButton.MouseButton1Up:Connect(function() moveUp = false end)
DownButton.MouseButton1Down:Connect(function() moveDown = true end)
DownButton.MouseButton1Up:Connect(function() moveDown = false end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.E then moveUp = true end
	if input.KeyCode == Enum.KeyCode.Q then moveDown = true end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.E then moveUp = false end
	if input.KeyCode == Enum.KeyCode.Q then moveDown = false end
end)

local isDraggingSlider = false
SliderBtn.MouseButton1Down:Connect(function() isDraggingSlider = true end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then isDraggingSlider = false end
end)

UserInputService.InputChanged:Connect(function(input)
	if isDraggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
		local mousePos = UserInputService:GetMouseLocation().X
		local sliderAbsolutePos = SliderBg.AbsolutePosition.X
		local sliderAbsoluteSize = SliderBg.AbsoluteSize.X
		local relativeX = math.clamp(mousePos - sliderAbsolutePos, 0, sliderAbsoluteSize)
		local percentage = relativeX / sliderAbsoluteSize
		SliderBtn.Position = UDim2.new(percentage, -6, 0, -5)
		
		flightSpeed = math.floor(percentage * 99 + 1)
		SpeedLabel.Text = "Fly Speed: " .. flightSpeed
	end
end)

RunService.RenderStepped:Connect(function()
	local char = player.Character
	if isFlying and char and char:FindFirstChild("HumanoidRootPart") then
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		local camera = workspace.CurrentCamera
		local moveDir = Vector3.new()

		if humanoid then
			local camCFrame = camera.CFrame
			local rawMove = humanoid.MoveDirection
			if rawMove.Magnitude > 0 then
				moveDir = (camCFrame.RightVector * rawMove.X - camCFrame.LookVector * rawMove.Z)
			end
		end

		local verticalDir = 0
		if moveUp then verticalDir = verticalDir + 1 end
		if moveDown then verticalDir = verticalDir - 1 end

		local finalVelocity = (moveDir * (flightSpeed * 1.5)) + Vector3.new(0, verticalDir * (flightSpeed * 1.5), 0)

		if linearVelocity and bodyGyro then
			linearVelocity.VectorVelocity = finalVelocity
			bodyGyro.CFrame = camera.CFrame
		end
	end
end)

local flungActive = false
FlungToggle.MouseButton1Click:Connect(function()
    flungActive = not flungActive
    if flungActive then
        FlungToggle.BackgroundColor3 = Color3.fromRGB(114, 137, 218)
        task.spawn(function()
            while flungActive do
                task.wait(0.1)
                pcall(function()
                    local char = player.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local myRoot = char.HumanoidRootPart
                        for _, pObj in ipairs(Players:GetPlayers()) do
                            if pObj ~= player and pObj.Character and pObj.Character:FindFirstChild("HumanoidRootPart") then
                                local otherRoot = pObj.Character.HumanoidRootPart
                                local distance = (myRoot.Position - otherRoot.Position).Magnitude
                                if distance < 5 then
                                    local bv = Instance.new("BodyVelocity")
                                    bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                    bv.Velocity = (otherRoot.Position - myRoot.Position).Unit * 150 + Vector3.new(0, 50, 0)
                                    bv.Parent = otherRoot
                                    task.delay(0.2, function() if bv then bv:Destroy() end end)
                                end
                            end
                        end
                    end
                end)
            end
        end)
    else
        FlungToggle.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    end
end)

local godMode = false
local godConnection
GodToggle.MouseButton1Click:Connect(function()
    godMode = not godMode
    if godMode then
        GodToggle.BackgroundColor3 = Color3.fromRGB(114, 137, 218)
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.Health = hum.MaxHealth
                godConnection = hum.HealthChanged:Connect(function()
                    if godMode and hum then hum.Health = hum.MaxHealth end
                end)
            end
        end
    else
        GodToggle.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
        if godConnection then godConnection:Disconnect(); godConnection = nil end
    end
end)

local invisActive = false
InvisibilityToggle.MouseButton1Click:Connect(function()
    invisActive = not invisActive
    pcall(function()
        local char = player.Character
        if not char then return end
        
        if invisActive then
            InvisibilityToggle.BackgroundColor3 = Color3.fromRGB(114, 137, 218)
            InvisibilityToggle.Text = "เปิด/ปิด ล่องหน (Invisibility): ON"
            
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                    v.Transparency = 1
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v.Transparency = 1
                elseif v:IsA("Accessory") then
                    local handle = v:FindFirstChild("Handle")
                    if handle then handle.Transparency = 1 end
                end
            end
        else
            InvisibilityToggle.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
            InvisibilityToggle.Text = "เปิด/ปิด ล่องหน (Invisibility): OFF"
            
            for _, v in ipairs(char:GetDescendants()) do
                if v:IsA("BasePart") and v.Name ~= "HumanoidRootPart" then
                    v.Transparency = 0
                elseif v:IsA("Decal") or v:IsA("Texture") then
                    v.Transparency = 0
                elseif v:IsA("Accessory") then
                    local handle = v:FindFirstChild("Handle")
                    if handle then handle.Transparency = 0 end
                end
            end
        end
    end)
end)

